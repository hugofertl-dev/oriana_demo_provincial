<mxfile host="app.diagrams.net" agent="claude" version="24.0.0">
  <diagram name="Memoria compartida" id="memoria-compartida">
    <mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="640" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="lienzo" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1260" height="620" as="geometry" />
        </mxCell>

        <mxCell id="title" value="Cómo se comparte el conocimiento en el arnés" style="text;html=1;fontSize=19;fontStyle=1;align=center;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="200" y="30" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="(y qué tramo es automático vs. qué hay que sostener)" style="text;html=1;fontSize=13;align=center;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="200" y="60" width="900" height="22" as="geometry" />
        </mxCell>

        <!-- FLUJO -->
        <mxCell id="paso1" value="👤 VOS&#10;corregís o&#10;rechazás algo&#10;(un diseño, un dato,&#10;una suposición)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="170" height="110" as="geometry" />
        </mxCell>

        <mxCell id="paso2" value="El agente lo ESCRIBE&#10;como regla&#10;―――&#10;al cerrar la tarea&#10;(skill feature-close)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="150" width="180" height="110" as="geometry" />
        </mxCell>

        <mxCell id="paso3" value="Queda en el REPO&#10;―――&#10;docs/lessons.md&#10;skill design-system&#10;CLAUDE.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1a1a1a;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="150" width="180" height="110" as="geometry" />
        </mxCell>

        <mxCell id="paso4" value="Lo reciben TODOS&#10;―――&#10;otros devs +&#10;tus sesiones futuras&#10;(sin que nadie explique nada)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="950" y="150" width="190" height="110" as="geometry" />
        </mxCell>

        <mxCell id="f1" value="" style="endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=3;" edge="1" parent="1" source="paso1" target="paso2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" value="" style="endArrow=classic;html=1;strokeColor=#d6b656;strokeWidth=3;" edge="1" parent="1" source="paso2" target="paso3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" value="git&#10;(push / pull)" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=3;fontColor=#1a4d1a;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="paso3" target="paso4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- BANDA: CAPTURA (depende) -->
        <mxCell id="banda1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;dashed=1;fontColor=#7a5c00;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="470" height="90" as="geometry" />
        </mxCell>
        <mxCell id="banda1txt" value="① CAPTURA — hay que SOSTENERLA&#10;Depende de que el proceso se siga: el agente ejecuta el cierre&#10;y vos estás para corregirlo. NADA lo fuerza solo.&#10;⚠ Si una sesión cierra sin esto, ese aprendizaje se pierde." style="text;html=1;align=left;fontColor=#7a5c00;fontSize=12;spacing=8;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="74" y="326" width="450" height="80" as="geometry" />
        </mxCell>

        <!-- BANDA: DISTRIBUCION (automatica) -->
        <mxCell id="banda2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;fontColor=#1a4d1a;" vertex="1" parent="1">
          <mxGeometry x="650" y="320" width="490" height="90" as="geometry" />
        </mxCell>
        <mxCell id="banda2txt" value="② DISTRIBUCIÓN — INFALIBLE&#10;Una vez escrito y commiteado, git lo reparte a todo el&#10;equipo y a cada sesión futura. Es mecánico: no depende&#10;de la memoria ni la buena voluntad de nadie." style="text;html=1;align=left;fontColor=#1a4d1a;fontSize=12;spacing=8;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="664" y="326" width="470" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ll1" value="" style="endArrow=none;html=1;strokeColor=#d6b656;strokeWidth=2;dashed=1;" edge="1" parent="1" source="paso2" target="banda1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ll2" value="" style="endArrow=none;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="paso4" target="banda2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- CIERRE HONESTO -->
        <mxCell id="cierre" value="El arnés NO &quot;aprende solo&quot;. Lo que hace: mueve lo que le decís desde una memoria privada hacia archivos del equipo.&#10;La DISTRIBUCIÓN es infalible (git). La CAPTURA hay que sostenerla con el proceso." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#6c8ebf;fontColor=#1f3a5f;fontSize=13;fontStyle=1;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="450" width="1080" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ejemplo" value="Ejemplo real (esta misma semana): tu regla de nombres de rama → quedó escrita en CLAUDE.md + el template; el gotcha del build web → en docs/lessons.md (15 entradas). No es promesa: ya pasó." style="text;html=1;align=center;fontColor=#555555;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="1080" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
